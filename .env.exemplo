# Exemplo do arquivo .env (copie para .env na raiz do projeto; o .env fica fora do Git).
# Uma variável por linha, no formato NOME=valor. Tire o "#" do começo da linha para usar.
# A variável de ambiente com o mesmo nome vale mais que o arquivo.

# ---------------------------------------------------------------- chaves de IA (a página grava pelo painel)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# IA_COMPATIVEL_API_KEY=

# ---------------------------------------------------------------- portais
# MCP_STARTUP_JOBS=          # chave opcional do startup.jobs

# Pausa entre os pedidos a cada portal que lê páginas, em segundos (de 3 a 60). Sem a linha, vale o padrão.
# Aumente só o portal que estiver bloqueando; vale a partir da busca seguinte, sem reiniciar.
# LINKEDIN_PAUSA=3   # padrão 3 a 7 s (sorteado); mínimo 3 s para este portal
# NERDIN_PAUSA=3     # padrão 3 s; mínimo 3 s para este portal
# INFOJOBS_PAUSA=3   # padrão 3 a 7 s (sorteado); mínimo 3 s para este portal
# VAGASCOM_PAUSA=3   # padrão 3 a 7 s (sorteado); mínimo 3 s para este portal
# EY_PAUSA=3         # padrão 3 a 7 s (sorteado); mínimo 3 s para este portal
# FULLSTACK_PAUSA=3  # padrão 3 a 7 s (sorteado); mínimo 3 s para este portal
# MYGREENHOUSE_PAUSA=3   # padrão 3 a 7 s (sorteado); mínimo 3 s (portal com login, spec 041)
# JOBGETHER_PAUSA=2  # padrão 2 s; mínimo 2 s (API oficial; o Crawl-delay do site)
