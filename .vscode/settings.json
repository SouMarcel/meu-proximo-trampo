{
  // Live Server: abrir dash/dashboard.html funciona com o servidor da tarefa "Dashboard" rodando.
  // O banco e os arquivos de trabalho mudam a cada gravação; sem ignorá-los, a página recarregaria toda hora.
  "liveServer.settings.ignoreFiles": [
    ".vscode/**", "**/*.scss", "**/*.sass", "**/*.ts",
    ".git/**", ".cache/**", "dash/dados/**", "anexos/**", "curriculos/**",
    "**/*.py", "**/__pycache__/**", "**/*.json", "**/*.md"
  ]
}
